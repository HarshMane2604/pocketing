DATABASE_URL=sqlite+aiosqlite:///./data/pocketing.db
FRONTEND_ORIGIN=http://localhost:5173

# Create a bot with @BotFather. Leave empty to disable Telegram capture.
TELEGRAM_BOT_TOKEN=

# Optional: lock the bot to this chat immediately. When empty, the first chat
# that messages the bot is paired automatically and remembered in SQLite.
TELEGRAM_ALLOWED_CHAT_ID=
